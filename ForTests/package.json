{
  "name": "verdant-reach-ship-redesign-lab",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "npm run test:core && npm run test:sloop",
    "smoke": "node browser-smoke.mjs",
    "test:ships": "node --expose-gc --test --test-concurrency=1 tests/ship-redesign.test.js",
    "check:modules": "node verify-game-modules.mjs",
    "visual-audit": "node visual-audit.mjs",
    "audit:barque": "node visual-audit.mjs --ship barque",
    "audit:vessel": "node visual-audit.mjs --ship",
    "test:core": "node --expose-gc --test --test-concurrency=1 tests/editor-defaults.test.js tests/editor-interface.test.js tests/editor-persistence.test.js tests/ship-redesign.test.js",
    "test:sloop": "node --expose-gc --test --test-concurrency=1 tests/sloop-reference.test.js"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "playwright": "1.64.1"
  },
  "description": "Standalone ship design studio with 16 independent vessel geometry generators"
}
